<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.boardproject.domain.post.repository.PostMapper">

    <resultMap id="PostWithAuthor" type="com.example.boardproject.domain.post.entity.Post">
        <id property="postId" column="post_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="userId" column="user_id"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <association property="user" javaType="com.example.boardproject.domain.user.entity.User">
            <id property="userId" column="user_id"/>
            <result property="loginId" column="login_id"/>
            <result property="nickname" column="nickname"/>
            <result property="createdAt" column="user_created_at"/>
        </association>
    </resultMap>

    <!-- 게시글 목록 조회 (페이징, 정렬) -->
    <select id="findAllWithPaging" resultMap="PostWithAuthor">
        SELECT
        p.post_id,
        p.title,
        p.user_id,
        p.created_at,
        u.user_id,
        u.nickname
        FROM post p
        INNER JOIN users u ON p.user_id = u.user_id
        ORDER BY p.created_at ${sortDirection}
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- 게시글 총 개수 -->
    <select id="countAll" resultType="long">
        SELECT COUNT(*)
        FROM post
    </select>

    <!-- 게시글 상세 조회 (작성자 정보 포함) -->
    <select id="findByIdWithAuthor" resultMap="PostWithAuthor">
        SELECT
        p.post_id,
        p.title,
        p.content,
        p.user_id,
        p.created_at,
        p.updated_at,
        u.user_id,
        u.login_id,
        u.nickname,
        u.created_at as user_created_at
        FROM post p
        INNER JOIN users u ON p.user_id = u.user_id
        WHERE p.post_id = #{postId}
    </select>

</mapper>